{
    "name": "sedie-client-demo",
    "version": "1.0.0",
    "description": "Game client demo application",
    "private": true,
    "workspaces": [
        "seal-monorepo"
    ],
    "scripts": {
        "start": "cd seal-monorepo && nx serve saba-games",
        "start:hot-league": "cd seal-monorepo && nx serve hot-league-wall",
        "start:hot-league-test": "cd seal-monorepo && nx serve hot-league-wall-test",
        "build": "cd seal-monorepo && nx build saba-games",
        "build:hot-league": "cd seal-monorepo && nx build hot-league-wall",
        "build:hot-league-test": "cd seal-monorepo && nx build hot-league-wall-test",
        "test": "cd seal-monorepo && nx test saba-games",
        "test:hot-league": "cd seal-monorepo && nx test hot-league-wall",
        "test:hot-league-test": "cd seal-monorepo && nx test hot-league-wall-test",
        "test-coverage": "cd seal-monorepo && nx run-many --target=test --all --coverage",
        "test-coverage:saba": "cd seal-monorepo && nx test saba-games --coverage",
        "test-coverage:hot-league": "cd seal-monorepo && nx test hot-league-wall --coverage",
        "storybook:hot-league": "cd seal-monorepo && nx run hot-league-wall:storybook",
        "build-storybook:hot-league": "cd seal-monorepo && nx run hot-league-wall:build-storybook",
        "lint": "cd seal-monorepo && nx lint"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "author": "",
    "license": "MIT",
    "dependencies": {
        "cross-env": "^7.0.3"
    },
    "devDependencies": {
        "nx": "18.0.4"
    }
}